# Database path
DB_PATH=data/leads.db

# Lead sources
GOOGLE_PLACES_API_KEY=
GEOAPIFY_API_KEY=
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Web presence verification (Google Custom Search API)
SEARCH_API_KEY=
SEARCH_ENGINE_ID=

# Lead CSV export/import path
LEADS_CSV_PATH=leads.csv

# Logging format (text or json)
LOG_FORMAT=text

# Enrichment TTL in days (Google Places content caching policy)
ENRICHMENT_TTL_DAYS=7
